# ---- large artefacts (kept on the shared Drive, mirroring these paths) ----
weights/
models/*.onnx
models/*.engine
models/mt5_pruned_onnx/
models/*/*.engine

# ---- data ----
data/raw/
data/test_frames/
data/calib_frames/*.jpg
data/clips/**/frames/
# ...and the dev-split fetch, which the test-split pattern above does not cover. 2.4 GB of frames
# were sitting untracked-but-addable on 2026-10-05, one `git add -A` from the history -- the same gap
# `results/*.pkl` had against its subdirectories. Frames are regenerable from data/openasl_fetch.py;
# the meta.json files are small and ARE tracked, which is what the pose pipeline needs.
data/clips_dev/**/frames/
data/clips_*/**/frames/
data/openasl_test_pose/
data/openasl_dev_pose/
data/openasl_train_pose/
data/openasl_train_pose_smoke/
data/openasl_ref_pose/*.pkl

# ---- bulky results (keep the .json and RESULTS.md, drop raw dumps) ----
results/*.csv
# ...except the M4/C10 deliverable named in PROJECT-GUIDE row 5.4, which is 728 bytes.
!results/frontier.csv
results/*.npz
# 46 MB of raw 133-keypoint dumps (4 configs x 5 clips): the input to 2.5 pose->BLEU, and
# reproducible with jetson/p4_clips.sh. The derived results/kpt_agreement_*.json ARE tracked.
results/kpts/
# the OpenASL authors' own released pose pkls for our 5 test clips (35 MB), fetched by
# data/openasl_pose_fetch.py; they are the ceiling row for the pose->BLEU comparison.
data/openasl_5clip_pose/
# the 30-clip superset of the same released poses (25 MB of pkl), fetched the same way
data/openasl_pose/
results/*.pkl
# ...and in SUBdirectories, which the line above does NOT match. That gap let 296 MB of n=400 pose
# pkls (results/pkl_split_rtmw_fp16{,_raw}/) sit untracked-but-addable, one `git add -A results/`
# away from the history. Pose pkls are regenerable -- from data/openasl_pose_fetch.py for the
# authors' poses, or from task1_rtmpose/09_batch_clips.py for ours -- so they belong on disk and on
# the shared Drive, never in git.
results/**/*.pkl
results/pkl_*/

# ---- python / envs / editors ----
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# ---- credentials (never commit) ----
Jetson-access.md

# ---- local mirror of the shared large-file repo (nested git clone) ----
model-data-lpcv/

# RTMW SDK export (123 MB); canonical copy on the Mac, re-download from the OpenMMLab SDK zip
models/rtmw/*.onnx

# OpenASL release tables, re-downloaded by data/openasl_fetch.py (40 MB)
data/openasl_meta/
# author-style 224x224 re-crop of the same five clips (crop-recipe experiment); regenerable with
# data/openasl_fetch.py --crop-style openasl, and verified by data/verify_openasl_crop.py
data/clips_openasl/*/frames/

# transient fetch log (progress only; the real state is the clip dirs on disk)
results/logs/fetch_full_split.log

# ---- from the LM track ----
runs/
scratchpad/
weights/adapt_*.pt
